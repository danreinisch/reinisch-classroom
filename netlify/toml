[build]
  publish = "site"
  functions = "netlify/functions"

[functions]
  node_bundler = "esbuild"

# Protect /admin with Basic Auth via Edge Function (reads ADMIN_USER/ADMIN_PASS from env)
[[edge_functions]]
path = "/admin"
function = "admin-basic-auth"

[[edge_functions]]
path = "/admin/*"
function = "admin-basic-auth"

# Also protect the function URL itself (extra layer in addition to ADMIN_KEY)
[[edge_functions]]
path = "/.netlify/functions/incremental-deploy"
function = "admin-basic-auth"

# Simple route to verify Edge Functions are active
[[edge_functions]]
path = "/edge-ping"
function = "edge-ping"
