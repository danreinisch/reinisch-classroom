[build]
  publish = "site"
  functions = "netlify/functions"

[functions]
  node_bundler = "esbuild"

# Protect /admin with Basic Auth via Edge Function (uses ADMIN_USER/ADMIN_PASS env vars)
[[edge_functions]]
path = "/admin"
function = "admin-basic-auth"

[[edge_functions]]
path = "/admin/*"
function = "admin-basic-auth"

# Simple route to verify Edge Functions are active
[[edge_functions]]
path = "/edge-ping"
function = "edge-ping"
