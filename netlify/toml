[build]
  publish = "site"
  functions = "netlify/functions"

[functions]
  node_bundler = "esbuild"

# Edge Functions routing for /admin (username/password prompt before page loads)
[[edge_functions]]
path = "/admin"
function = "admin-basic-auth"

[[edge_functions]]
path = "/admin/*"
function = "admin-basic-auth"

# Optional: protect the function URL itself with the same Basic Auth (in addition to ADMIN_KEY).
# Uncomment to enable.
# [[edge_functions]]
# path = "/.netlify/functions/incremental-deploy"
# function = "admin-basic-auth"

# Optional: a tiny route to verify Edge Functions are running (GET /edge-ping => "edge ok")
[[edge_functions]]
path = "/edge-ping"
function = "edge-ping"
