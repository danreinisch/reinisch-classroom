[build]
  publish = "site"
  functions = "netlify/functions"

[functions]
  node_bundler = "esbuild"

# Edge guard for admin pages and the upload function (requires session cookie)
[[edge_functions]]
path = "/admin"
function = "admin-auth-guard"

[[edge_functions]]
path = "/admin/*"
function = "admin-auth-guard"

# Also protect direct function hits in addition to ADMIN_KEY inside the function
[[edge_functions]]
path = "/.netlify/functions/incremental-deploy"
function = "admin-auth-guard"

# Simple route to verify Edge Functions are active
[[edge_functions]]
path = "/edge-ping"
function = "edge-ping"
