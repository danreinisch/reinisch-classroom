[build]
  publish = "site"
  functions = "netlify/functions"

[functions]
  node_bundler = "esbuild"

# TEMP: hard-block /admin to prove edge routing is active
[[edge_functions]]
path = "/admin"
function = "admin-hardblock"

[[edge_functions]]
path = "/admin/*"
function = "admin-hardblock"

# Also block direct function hits (optional, but good test)
[[edge_functions]]
path = "/.netlify/functions/incremental-deploy"
function = "admin-hardblock"

# Health check to prove Edge Functions are live
[[edge_functions]]
path = "/edge-ping"
function = "edge-ping"
