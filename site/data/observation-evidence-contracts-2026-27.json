    "S059.CG6": {
      "event_type": "performance_trial",
      "capture_source": "observation_center",
      "label": "Daily schedule-following performance",
      "fields": [
        { "key": "successful_steps", "kind": "integer", "min": 0 },
        { "key": "total_steps", "kind": "integer", "min": 1 },
        { "key": "support_level", "kind": "optional_text" }
      ],
      "success_rule": { "operator": "ratio_at_least", "numerator": "successful_steps", "denominator": "total_steps", "value": 0.8 },
      "dispositions": ["absent"],
      "note_optional": true
    },
    "S060.CG1": {
      "event_type": "composite",
      "capture_source": "observation_center",
      "label": "Combined reading-performance trial",
      "components": [
        { "key": "independent_reading", "label": "Reads the grade-level passage independently", "kind": "met_not_met", "required": true },
        { "key": "comprehension_participation", "label": "Participates in comprehension questions", "kind": "met_not_met", "required": true },
        { "key": "regulation_strategy", "label": "Stays calm and uses a strategy to manage frustration", "kind": "met_not_met", "required": true }
      ],
      "success_rule": { "operator": "all_required_met" },
      "dispositions": ["absent", "no_opportunity"],
      "note_optional": true,
      "criterion_note": "Preserve the official stored criterion/mastery; do not rewrite the source wording."
    },
    "S060.CG2": {
      "event_type": "count",
      "capture_source": "observation_center",
      "label": "Task completion and prompt count",
      "fields": [
        { "key": "completed", "kind": "boolean" },
        { "key": "prompt_count", "kind": "integer", "min": 0 }
      ],
      "success_rule": { "operator": "all", "rules": [
        { "field": "completed", "operator": "eq", "value": true },
        { "field": "prompt_count", "operator": "lte", "value": 2 }
      ] },
      "dispositions": ["absent", "no_opportunity"],
      "note_optional": true
    },
    "S061.CG1": {
