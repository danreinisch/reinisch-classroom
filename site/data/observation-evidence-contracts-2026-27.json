        { "key": "identify_conflict", "label": "Identifies the conflict", "kind": "met_not_met", "required": true },
        { "key": "appropriate_regulated_response", "label": "Gives an appropriate response using a taught regulation strategy", "kind": "met_not_met", "required": true },
        { "key": "inappropriate_response_to_avoid", "label": "Names an inappropriate response to avoid", "kind": "met_not_met", "required": true }
      ],
      "success_rule": { "operator": "all_required_met" },
      "dispositions": ["absent", "no_opportunity"],
      "note_optional": true
    },
    "S059.CG5": {
      "event_type": "opportunity",
      "capture_source": "observation_center",
