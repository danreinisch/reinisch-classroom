# Long-cache a large video asset
/assets/HomePageBackground.mp4
  Cache-Control: public, max-age=31536000, immutable

# Ensure HTML is served with correct content type for this specific path
/life-skills/presentations/presentation-03/index.html
  Content-Type: text/html; charset=utf-8

# Admin area: never cache and prevent indexing (auth is enforced by Edge Function)
/admin/*
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache
  X-Robots-Tag: noindex
