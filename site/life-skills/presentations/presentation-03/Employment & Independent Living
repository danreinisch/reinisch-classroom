            font-weight: bold;
            font-size: 1.3em;
        }
        
        .example-box {
            background: #f0fff0;
            border: 2px solid #4CAF50;
            padding: 20px;
            border-radius: 10px;
            margin: 20px 0;
        }
        
        .example-box h4 {
            color: #4CAF50;
            margin-top: 0;
        }
        
        .community-box {
            background: #fff3e0;
            border: 2px solid #ff9800;
            padding: 20px;
            border-radius: 10px;
            margin: 20px 0;
        }
        
        .community-box h4 {
            color: #ff9800;
            margin-top: 0;
        }
        
        .navigation {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 15px;
            z-index: 1000;
        }
        
        .nav-btn {
            background: rgba(255, 255, 255, 0.9);
            border: none;
