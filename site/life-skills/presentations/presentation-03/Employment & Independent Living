<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Life Skills Presentation: Employment & Independent Living</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            overflow: hidden;
        }
        
        .presentation-container {
            width: 100vw;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }
        
        .slide {
            display: none;
            width: 90%;
            max-width: 1000px;
            height: 80%;
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
            color: #333;
            overflow-y: auto;
            animation: slideIn 0.5s ease-in-out;
        }
        
        .slide.active {
            display: block;
        }
        
        @keyframes slideIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .slide h1 {
            color: #667eea;
            text-align: center;
            margin-bottom: 30px;
            font-size: 2.5em;
        }
        
        .slide h2 {
            color: #764ba2;
            border-bottom: 3px solid #FFE066;
            padding-bottom: 10px;
            margin-top: 30px;
            font-size: 2em;
        }
        
        .slide h3 {
            color: #667eea;
            font-size: 1.5em;
            margin-top: 25px;
        }
        
        .slide-content {
            font-size: 1.2em;
            line-height: 1.6;
        }
        
        .icons-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin: 20px 0;
        }
        
        .icon-item {
            text-align: center;
            padding: 20px;
            background: #f8f9fa;
            border-radius: 15px;
            border: 3px solid #667eea;
            transition: transform 0.3s;
        }
        
        .icon-item:hover {
            transform: scale(1.05);
        }
        
        .icon-item .emoji {
            font-size: 3em;
            margin-bottom: 10px;
        }
        
        .icon-item h4 {
            color: #667eea;
            margin: 10px 0;
        }
        
        .bullet-points {
            background: #e8f4f8;
            padding: 20px;
            border-radius: 10px;
            border-left: 5px solid #667eea;
            margin: 20px 0;
        }
        
        .bullet-points ul {
            font-size: 1.1em;
            color: #333;
        }
        
        .bullet-points li {
            margin: 10px 0;
            padding-left: 10px;
        }
        
        .highlight-box {
            background: linear-gradient(135deg, #FFE066 0%, #FFA000 100%);
            padding: 20px;
            border-radius: 15px;
            text-align: center;
            margin: 20px 0;
