{
  "name": "reinisch-classroom-tests",
  "version": "1.0.0",
  "description": "Automated tests for Reinisch Classroom",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test tests/student-manager-smoke.spec.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:inline-scripts": "node scripts/check-inline-scripts.cjs",
    "check:nav-script": "node scripts/check-asset-paths.cjs",
    "postbuild": "node scripts/check-env-leaks.js && node scripts/check-inline-scripts.cjs && node scripts/check-asset-paths.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "eslint": "^8.57.1",
    "prettier": "^3.1.1"
  }
}
