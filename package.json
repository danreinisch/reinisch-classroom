{
  "name": "reinisch-classroom-tests",
  "version": "1.0.0",
  "description": "Automated tests for Reinisch Classroom",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test tests/student-manager-smoke.spec.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-leaks": "node scripts/check-env-leaks.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1"
  }
}
